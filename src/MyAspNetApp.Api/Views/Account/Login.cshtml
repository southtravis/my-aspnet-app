@{
    Layout = null;
}
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Login</title>
  <style>body{font-family:Segoe UI,Arial,sans-serif;margin:40px;color:#333} label{display:block;margin-top:8px}</style>
</head>
<body>
  <h1>Login</h1>
  @if(ViewBag.Error != null){
    <div style="color:#a00">@ViewBag.Error</div>
  }
  <form method="post">
    <label>Username <input name="username" /></label>
    <label>Password <input name="password" type="password" /></label>
    <button type="submit">Log in</button>
  </form>
</body>
</html>